# Variáveis a cadastrar no projeto do Vercel (Settings, Environment Variables, ou `vercel env add`).
# Este arquivo é só um modelo: nunca coloque valores reais aqui nem faça commit de um .env.

APP_NAME=CONECTA_OSC
APP_ENV=production
APP_DEBUG=false
APP_URL=https://SEU-PROJETO.vercel.app
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

# Gere com: php artisan key:generate --show   (uma chave diferente para Production e Preview)
APP_KEY=
# Gere com: php -r "echo base64_encode(random_bytes(32));"
JWT_SECRET=

# Banco: TiDB Cloud Starter (compatível com MySQL). Os dados ficam no painel do TiDB, em "Connect".
# O Laravel só lê as variáveis DB_*: se a integração do Marketplace criar outras (TIDB_*, DATABASE_URL),
# copie os valores para estas.
DB_CONNECTION=mysql
DB_HOST=gateway01.REGIAO.prod.aws.tidbcloud.com
DB_PORT=4000
DB_DATABASE=uoscc_redecam
# O usuário do TiDB tem um prefixo (ex.: 2abc3def.conecta). Crie um usuário próprio para o app, não use o .root.
DB_USERNAME=
DB_PASSWORD=
# O TiDB Cloud exige TLS. Este é o arquivo de CAs do sistema dentro da imagem (Debian) e também no Ubuntu.
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
INERTIA_SSR_ENABLED=false

CSP_ENABLED=true
HSTS_MAX_AGE=31536000
API_DOCS_PUBLIC=false
# Origens que podem chamar a API pelo navegador. Use a própria URL do site (sem barra no fim), nunca *.
CORS_ALLOWED_ORIGINS=https://SEU-PROJETO.vercel.app

# Opcional: anti-robô do formulário público (Cloudflare Turnstile). Vazio = desligado.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
