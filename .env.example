APP_NAME=Redcam
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=uoscc_redecam
DB_USERNAME=uoscc_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ------------------------------------------------------------
# Segurança (config/seguranca.php e config/services.php)
# Em produção confira tudo com: php artisan seguranca:verificar
#   APP_ENV=production | APP_DEBUG=false | APP_URL=https://...
#   SESSION_SECURE_COOKIE=true | SESSION_ENCRYPT=true
#   DB_USERNAME=uoscc_app (ver database/schema/usuario_aplicacao.sql)
# ------------------------------------------------------------
SESSION_SECURE_COOKIE=false
CSP_ENABLED=true
CSP_REPORT_ONLY=false

# Cloudflare Turnstile (anti-robô do formulário público). Vazio = desligado.
# Chaves de teste da Cloudflare (sempre aprovam): 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ------------------------------------------------------------
# Login por JWT (site em cookie HttpOnly, API em Authorization: Bearer) – config/jwt.php
# ------------------------------------------------------------
# Chave da assinatura (32+ caracteres). Vazia: derivada da APP_KEY. Gere com:
#   php -r "echo base64_encode(random_bytes(32));"
JWT_SECRET=
# Validade em minutos: com "Manter conectado" e na API (7 dias) e sem ele (2 horas)
JWT_TTL=10080
JWT_TTL_SEM_LEMBRAR=120

# ------------------------------------------------------------
# API REST (/api/v1) – documentação em /docs/api
# ------------------------------------------------------------
# Origens autorizadas a chamar a API pelo navegador, separadas por vírgula. Em produção, evite "*".
CORS_ALLOWED_ORIGINS=*
# Exibir /docs/api fora de APP_ENV=local
API_DOCS_PUBLIC=false
API_VERSION=1.0.0

# ------------------------------------------------------------
# SSR do Inertia (HTML gerado no servidor, melhor para SEO)
# Build: npm run build:ssr · Servidor Node: php artisan inertia:start-ssr
# Ative em produção (true). Em desenvolvimento deixe false: com `npm run dev`
# o bundle de SSR ficaria desatualizado. Sem o servidor SSR, o site renderiza no navegador.
# ------------------------------------------------------------
INERTIA_SSR_ENABLED=false
