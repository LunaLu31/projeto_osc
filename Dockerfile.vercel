# syntax=docker/dockerfile:1
# CONECTA_OSC no Vercel: Laravel 12 em contêiner com FrankenPHP (PHP 8.4).
# Baseado no guia oficial: https://vercel.com/kb/guide/laravel-php-with-docker
# Acréscimos deste projeto: pdo_mysql (MySQL externo) e a etapa Node que gera public/build.

# ---------- base: FrankenPHP com as extensões que o projeto usa ----------
FROM dunglas/frankenphp:1-php8.4-bookworm AS base

RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && install-php-extensions intl zip pdo_mysql opcache

WORKDIR /app

# ---------- dependencies: Composer sem dev ----------
FROM base AS dependencies

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY composer.json composer.lock ./
RUN composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --no-scripts \
    --optimize-autoloader \
    --prefer-dist

# dump-autoload roda o package:discover do Laravel (gera bootstrap/cache/packages.php sem pacotes de dev).
COPY . .
RUN mkdir -p \
        storage/framework/cache \
        storage/framework/sessions \
        storage/framework/views \
        storage/logs \
        bootstrap/cache \
    && composer dump-autoload --no-dev --classmap-authoritative

# ---------- assets: build do front (Vite + React + Tailwind) ----------
FROM node:22-bookworm-slim AS assets

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY resources ./resources
COPY public ./public
COPY vite.config.ts tsconfig.json tsconfig.node.json ./
RUN npm run build

# ---------- runtime ----------
FROM base AS runtime

COPY --from=dependencies --chown=www-data:www-data /app /app
COPY --from=assets --chown=www-data:www-data /app/public/build /app/public/build
COPY --chown=www-data:www-data Caddyfile /etc/frankenphp/Caddyfile

# O disco do contêiner não é durável: storage serve só para arquivos temporários desta instância.
RUN setcap CAP_NET_BIND_SERVICE=+eip /usr/local/bin/frankenphp \
    && chown -R www-data:www-data /config/caddy /data/caddy

# Padrões de produção. As variáveis do projeto no Vercel sobrescrevem estes valores.
# Cache e sessão ficam no MySQL porque os logins JWT revogados são guardados no cache
# (app/Auth/TokensJwt.php) e precisam valer entre instâncias. Não troque por "array".
# Não há jobs (nenhum dispatch no código), então a fila síncrona é segura.
ENV PORT=80 \
    APP_ENV=production \
    APP_DEBUG=false \
    LOG_CHANNEL=stderr \
    CACHE_STORE=database \
    SESSION_DRIVER=database \
    SESSION_SECURE_COOKIE=true \
    QUEUE_CONNECTION=sync \
    INERTIA_SSR_ENABLED=false

USER www-data

CMD ["frankenphp", "run", "--config", "/etc/frankenphp/Caddyfile"]
