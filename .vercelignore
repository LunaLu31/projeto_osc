# Arquivos que o `vercel deploy` não envia. A imagem é montada a partir do que sobrar
# (o .dockerignore filtra de novo dentro do build).
.env
.env.*
!.env.example
!.env.vercel.example
.vercel
node_modules
vendor
public/build
public/hot
bootstrap/cache/*.php
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/framework/testing/*
.phpunit.result.cache
